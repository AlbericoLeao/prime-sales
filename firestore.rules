rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function emailOf() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isSignedIn() && emailOf() == 'albericoprestes2014@gmail.com';
    }

    function isOwner(emailField) {
      return isSignedIn() && emailField != null && emailField.lower() == emailOf();
    }

    function validCompanyPdf() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'pdfNomeExibido', 'pdfTextoAbaixoLogo', 'logoDataUrl', 'pdfContatoExibido', 'pdfRodape'
        ]) && data.keys().hasOnly([
          'pdfNomeExibido', 'pdfTextoAbaixoLogo', 'logoDataUrl', 'pdfContatoExibido', 'pdfRodape'
        ]) &&
        data.pdfNomeExibido is string && data.pdfNomeExibido.size() <= 120 &&
        data.pdfTextoAbaixoLogo is string && data.pdfTextoAbaixoLogo.size() <= 200 &&
        data.logoDataUrl is string && data.logoDataUrl.size() <= 700000 &&
        (data.logoDataUrl == '' || data.logoDataUrl.matches('data:image/(png|jpeg);base64,[A-Za-z0-9+/]*={0,2}')) &&
        data.pdfContatoExibido is string && data.pdfContatoExibido.size() <= 250 &&
        data.pdfRodape is string && data.pdfRodape.size() <= 600;
    }

    match /configuracoes/{configId} {
      allow get: if isAdmin() || (isSignedIn() && configId == 'empresaPdf');
      allow list: if isAdmin();
      allow create, update: if isAdmin() && (
        configId == 'empresa' || (configId == 'empresaPdf' && validCompanyPdf())
      );
      allow delete: if isAdmin() && configId in ['empresa', 'empresaPdf'];
    }

    match /vendedores/{email} {
      allow get: if isSignedIn() && (isAdmin() || emailOf() == email.lower());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && emailOf() == email.lower());
      allow delete: if isAdmin();
    }

    match /clientes/{clienteId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.vendedorEmail != null && resource.data.vendedorEmail.lower() == emailOf());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && (
        isAdmin() || (
          request.resource.data.vendedorEmail != null &&
          request.resource.data.vendedorEmail.lower() == emailOf()
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.vendedorEmail != null &&
          resource.data.vendedorEmail.lower() == emailOf() &&
          request.resource.data.vendedorEmail != null &&
          request.resource.data.vendedorEmail.lower() == emailOf()
        )
      );
      allow delete: if isAdmin();
    }

    match /produtos/{produtoId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /pedidos/{pedidoId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.vendedorEmail != null && resource.data.vendedorEmail.lower() == emailOf());
      allow list: if isSignedIn() && (isAdmin() || request.auth.token.email != null);
      allow create: if isSignedIn() && (
        request.resource.data.vendedorEmail != null &&
        request.resource.data.vendedorEmail.lower() == emailOf()
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.vendedorEmail != null &&
        resource.data.vendedorEmail.lower() == emailOf() &&
        request.resource.data.vendedorEmail != null &&
        request.resource.data.vendedorEmail.lower() == emailOf() &&
        request.resource.data.clienteId == resource.data.clienteId &&
        request.resource.data.itens == resource.data.itens &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }
  }
}

