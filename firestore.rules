rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function admin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && email() == 'albericoprestes2014@gmail.com';
    }

    function activeSeller() {
      return signedIn()
        && exists(/databases/$(database)/documents/vendedores/$(email()))
        && (
          (
            'status' in get(/databases/$(database)/documents/vendedores/$(email())).data
            && get(/databases/$(database)/documents/vendedores/$(email())).data.status == 'ativo'
          )
          || (
            !('status' in get(/databases/$(database)/documents/vendedores/$(email())).data)
            && 'ativo' in get(/databases/$(database)/documents/vendedores/$(email())).data
            && get(/databases/$(database)/documents/vendedores/$(email())).data.ativo == true
          )
        )
        && (!('bloqueado' in get(/databases/$(database)/documents/vendedores/$(email())).data)
          || get(/databases/$(database)/documents/vendedores/$(email())).data.bloqueado != true);
    }

    function activeProduct() {
      return resource.data.ativo == true;
    }

    function assignedClient(clienteId) {
      return activeSeller()
        && clienteId is string
        && exists(/databases/$(database)/documents/clientes/$(clienteId))
        && get(/databases/$(database)/documents/clientes/$(clienteId)).data.vendedorEmail == email()
        && (!('status' in get(/databases/$(database)/documents/clientes/$(clienteId)).data)
          || get(/databases/$(database)/documents/clientes/$(clienteId)).data.status != 'inativo');
    }

    function validAdminOrderArchive() {
      return admin()
        && (!('arquivado' in resource.data) || resource.data.arquivado != true)
        && request.resource.data.status == resource.data.status
        && request.resource.data.arquivado == true
        && request.resource.data.arquivadoPorEmail == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'arquivado', 'arquivadoEm', 'arquivadoPor', 'arquivadoPorEmail',
          'atualizadoEm'
        ]);
    }

    match /vendedores/{sellerEmail} {
      allow read: if admin() || (signedIn() && sellerEmail == email());
      allow create: if admin()
        && request.resource.data.email == sellerEmail
        && request.resource.data.status in ['ativo', 'bloqueado'];
      allow update: if admin()
        && request.resource.data.email == sellerEmail
        && request.resource.data.status in ['ativo', 'bloqueado'];
      allow delete: if false;
    }

    match /produtos/{id} {
      allow read: if admin() || (activeSeller() && activeProduct());
      allow create, update: if admin();
      allow delete: if false;
    }

    match /clientes/{id} {
      allow read: if admin()
        || (activeSeller() && resource.data.vendedorEmail == email());
      allow create, update: if admin();
      allow delete: if false;
    }

    match /pedidos/{id} {
      allow read: if admin()
        || (activeSeller() && resource.data.vendedorEmail == email());
      // Orders are created and transitioned only by trusted callable functions.
      allow create: if false;
      allow update: if validAdminOrderArchive();
      allow delete: if false;
    }
  }
}
